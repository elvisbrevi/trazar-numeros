{
  "name": "trazar-numeros",
  "private": true,
  "version": "0.1.0",
  "description": "Juego para que los niños aprendan a escribir los números del 1 al 16 trazándolos con el dedo",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run && vite build",
    "deploy": "npm run check && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "wrangler": "^4.159.0"
  }
}
